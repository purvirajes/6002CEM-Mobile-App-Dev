<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpensesApp.Views.AddExpensePage"
             Title="Add Expense">

    <Grid>
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="20">
                <Label Text="Add New Expense" FontSize="20" FontAttributes="Bold"/>

                <Entry x:Name="NameEntry" Placeholder="Expense Name"/>

                <Entry x:Name="CostEntry" 
                       Placeholder="Amount" 
                       Keyboard="Numeric"/>

                <Picker x:Name="CategoryPicker" Title="Select Category">
                    <Picker.Items>
                        <x:String>Food</x:String>
                        <x:String>Transportation</x:String>
                        <x:String>Utilities</x:String>
                        <x:String>Entertainment</x:String>
                        <x:String>Other</x:String>
                    </Picker.Items>
                </Picker>

                <Button Text="Save Expense" 
                        Clicked="OnSaveExpenseClicked"
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </ScrollView>

        <Button Text="Back"
                Clicked="OnBackClicked"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="10"/>
    </Grid>
</ContentPage>
