<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpensesApp.Views.LoginPage"
             Title="Login">

    <Grid>
        <VerticalStackLayout Spacing="15" Padding="30,0">
            <Label Text="Login" FontSize="24" HorizontalOptions="Center" />

            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

            <Button Text="Login" Clicked="OnLoginButtonClicked" Margin="0,20" />

            <Label Text="Don't have an account?" HorizontalOptions="Center" />
            <Button Text="Register"
                    Clicked="OnRegisterClicked"
                    HorizontalOptions="Center"
                    WidthRequest="200" />
        </VerticalStackLayout>

        <Button Text="Back"
                Clicked="OnBackClicked"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="10"/>
    </Grid>
</ContentPage>
